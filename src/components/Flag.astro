---
// A language's flag as inline SVG. Flag emoji are not drawn on Windows (it shows the two letters
// instead), so the picker draws its own. Same flags as the mobile app's language picker.
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  size?: number;
}

const { lang, size = 20 } = Astro.props;
// A clip id unique to this instance (the UK flag needs one).
const clip = `flag-uk-${Math.random().toString(36).slice(2, 8)}`;
const h = Math.round((size * 2) / 3);
---

<svg class="flag" width={size} height={h} viewBox="0 0 30 20" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {lang === 'en' && (
    <svg viewBox="0 0 60 30" width="30" height="20" preserveAspectRatio="xMidYMid slice">
      <clipPath id={clip}><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path={`url(#${clip})`} stroke="#C8102E" stroke-width="4" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </svg>
  )}
  {lang === 'cs' && (
    <>
      <rect width="30" height="10" fill="#fff" />
      <rect y="10" width="30" height="10" fill="#D7141A" />
      <path d="M0,0 L15,10 L0,20 z" fill="#11457E" />
    </>
  )}
  {lang === 'de' && (
    <>
      <rect width="30" height="7" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#DD0000" />
      <rect y="13.33" width="30" height="6.67" fill="#FFCE00" />
    </>
  )}
  {lang === 'fr' && (
    <>
      <rect width="10" height="20" fill="#002395" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ED2939" />
    </>
  )}
  {lang === 'it' && (
    <>
      <rect width="10" height="20" fill="#009246" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#CE2B37" />
    </>
  )}
  {lang === 'sv' && (
    <>
      <rect width="30" height="20" fill="#006AA7" />
      <rect x="9.4" width="3.75" height="20" fill="#FECC00" />
      <rect y="8.1" width="30" height="3.75" fill="#FECC00" />
    </>
  )}
  {lang === 'fi' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <rect x="8.3" width="5" height="20" fill="#002F6C" />
      <rect y="7.5" width="30" height="5" fill="#002F6C" />
    </>
  )}
  {lang === 'no' && (
    <>
      <rect width="30" height="20" fill="#BA0C2F" />
      <rect x="8.2" width="5" height="20" fill="#fff" />
      <rect y="7.5" width="30" height="5" fill="#fff" />
      <rect x="9.45" width="2.5" height="20" fill="#00205B" />
      <rect y="8.75" width="30" height="2.5" fill="#00205B" />
    </>
  )}
  {lang === 'da' && (
    <>
      <rect width="30" height="20" fill="#C8102E" />
      <rect x="9.3" width="2.9" height="20" fill="#fff" />
      <rect y="8.55" width="30" height="2.9" fill="#fff" />
    </>
  )}
  {lang === 'ru' && (
    <>
      <rect width="30" height="6.67" fill="#fff" />
      <rect y="6.67" width="30" height="6.67" fill="#0039A6" />
      <rect y="13.33" width="30" height="6.67" fill="#D52B1E" />
    </>
  )}
</svg>

<style>
  .flag {
    display: inline-block;
    flex: none;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
    vertical-align: -2px;
  }
</style>
