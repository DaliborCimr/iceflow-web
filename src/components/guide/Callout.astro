---
// A highlighted note inside an article: a tip, something worth knowing, or a caveat.
import Icon from '../Icon.astro';

interface Props {
  type?: 'tip' | 'note' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const icon = { tip: 'lightbulb', note: 'info', warning: 'warning' }[type];
---

<aside class={`callout ${type}`}>
  <span class="icon"><Icon name={icon} size={20} /></span>
  <div>
    {title && <p class="title">{title}</p>}
    <div class="body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    --c: var(--accent);
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 9%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 12px 16px;
    margin: 1.2em 0 1.6em;
  }

  .tip {
    --c: #3ccf91;
  }

  .warning {
    --c: var(--gold);
  }

  .icon {
    color: var(--c);
    padding-top: 2px;
  }

  .title {
    margin: 0 0 2px;
    font-weight: 800;
    color: var(--text);
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 0.5em;
  }
</style>
