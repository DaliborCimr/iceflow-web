---
// A short muted looping video recorded in the app (public/media/<src>), with a screenshot from
// src/assets/screens as its poster so something shows before it loads.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { defaultLocale, type Locale } from '../../i18n/ui';

interface Props {
  src: string;
  poster: string;
  label: string;
  caption?: string;
}

const { src, poster, label, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*/*.webp', { eager: true });
const lang = Astro.params.lang as Locale;
const still =
  images[`../../assets/screens/${lang}/${poster}.webp`] ?? images[`../../assets/screens/${defaultLocale}/${poster}.webp`];
if (!still) throw new Error(`Missing poster "${poster}"`);
const posterImage = await getImage({ src: still.default, width: 1200 });
---

<figure class="clip">
  <video src={`/media/${src}`} poster={posterImage.src} aria-label={label} controls muted loop playsinline preload="none"></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .clip {
    margin: 1.2em 0 1.6em;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 20 / 9;
    background: #000;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
