---
// A short muted looping video recorded in the app (public/media/<src>), with a screenshot from
// src/assets/screens as its poster so something shows before it loads. It plays by itself while
// at least half of it is on screen and pauses when scrolled away; reduced motion leaves it paused.
import { getImage } from 'astro:assets';
import { url } from '../../url';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: string;
  label: string;
  caption?: string;
}

const { src, poster, label, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/en/*.webp', { eager: true });
const still = images[`../../assets/screens/en/${poster}.webp`];
if (!still) throw new Error(`Missing poster "${poster}"`);
const posterImage = await getImage({ src: still.default, width: 1200 });
---

<figure class="clip">
  <video src={url(`/media/${src}`)} poster={posterImage.src} aria-label={label} controls muted loop playsinline preload="none" data-autoplay></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.5 },
    );
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => observer.observe(v));
  }
</script>

<style>
  .clip {
    margin: 1.2em 0 1.6em;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 20 / 9;
    background: #000;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
