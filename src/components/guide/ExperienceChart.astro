---
// The spread of a player's match day by experience, drawn from the match engine's own
// day model (MatchEngineMath.generateMatchAttributeOffset, average professionalism).
// Shape only: the axes carry no numbers on purpose.
import { defaultLocale, type Locale } from '../../i18n/ui';

// The page's language comes from the route, so MDX can use <ExperienceChart /> bare.

const labels = {
  en: {
    title: 'How much a player’s day can vary, by experience',
    better: 'better day',
    worse: 'worse day',
    usual: 'usual level',
    less: 'little experience',
    more: 'a lot of experience',
    full: 'possible range',
    most: '9 games in 10',
    half: 'half of the games',
  },
  cs: {
    title: 'Jak moc se může lišit den hráče podle zkušeností',
    better: 'lepší den',
    worse: 'horší den',
    usual: 'obvyklá úroveň',
    less: 'málo zkušeností',
    more: 'hodně zkušeností',
    full: 'možný rozsah',
    most: '9 zápasů z 10',
    half: 'polovina zápasů',
  },
};
const l = labels[(Astro.params.lang as Locale) as keyof typeof labels] ?? labels[defaultLocale as 'en'];
---

