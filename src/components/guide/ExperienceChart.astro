    <text x="20" y="18" class="axis strong">{l.exp}</text>
    <text x="340" y="16" class="axis mid">{l.usual}</text>
    <text x="70" y="318" class="axis">← {l.worse}</text>
    <text x="610" y="318" class="axis end">{l.better} →</text>
  </svg>
  <figcaption>
    <span><i class="k0"></i>{l.full}</span>
    <span><i class="k1"></i>{l.most}</span>
    <span><i class="k2"></i>{l.half}</span>
  </figcaption>
</figure>

<style>
  .chart {
    margin: 1.2em 0 1.6em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 14px 10px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid {
    stroke: var(--border);
  }

  .b0 {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .b1 {
    fill: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .b2 {
    fill: var(--accent);
  }

  .zero {
    stroke: var(--text);
    stroke-dasharray: 4 4;
    opacity: 0.6;
  }

  .axis {
    fill: var(--muted);
    font-size: 13px;
  }

  .strong {
    fill: var(--text);
    font-weight: 700;
  }

  .end {
    text-anchor: end;
  }

  .mid {
    text-anchor: middle;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 6px;
  }

  figcaption i {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .k0 {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .k1 {
    background: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .k2 {
    background: var(--accent);
  }
</style>
