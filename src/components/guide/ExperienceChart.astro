    <line class="grid" x1="70" y1="290.0" x2="610" y2="290.0" />
    <text x="62" y="294.0" class="axis end">0</text>
    <line class="grid" x1="70" y1="225.0" x2="610" y2="225.0" />
    <text x="62" y="229.0" class="axis end">50</text>
    <line class="grid" x1="70" y1="160.0" x2="610" y2="160.0" />
    <text x="62" y="164.0" class="axis end">100</text>
    <line class="grid" x1="70" y1="95.0" x2="610" y2="95.0" />
    <text x="62" y="99.0" class="axis end">150</text>
    <line class="grid" x1="70" y1="30.0" x2="610" y2="30.0" />
    <text x="62" y="34.0" class="axis end">200</text>
