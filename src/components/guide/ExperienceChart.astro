    <line class="zero" x1="20" y1="150" x2="620" y2="150" />
    <text x="24" y="40" class="axis">{l.better} ↑</text>
    <text x="24" y="300" class="axis">{l.worse} ↓</text>
    <text x="616" y="143" class="axis end">{l.usual}</text>
    <text x="20" y="322" class="axis">← {l.less}</text>
    <text x="620" y="322" class="axis end">{l.more} →</text>
  </svg>
  <figcaption>
    <span><i class="k0"></i>{l.full}</span>
    <span><i class="k1"></i>{l.most}</span>
    <span><i class="k2"></i>{l.half}</span>
  </figcaption>
</figure>

<style>
  .chart {
    margin: 1.2em 0 1.6em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 14px 10px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .b0 {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .b1 {
    fill: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .b2 {
    fill: var(--accent);
  }

  .zero {
    stroke: var(--text);
    stroke-dasharray: 4 4;
    opacity: 0.5;
  }

  .axis {
    fill: var(--muted);
    font-size: 13px;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
  }

  .end {
    text-anchor: end;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 6px;
  }

  figcaption i {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .k0 {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .k1 {
    background: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .k2 {
    background: var(--accent);
  }
</style>
