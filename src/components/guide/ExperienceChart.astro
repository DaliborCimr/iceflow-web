    <path class="b1" d="M20.0,88.6 L35.0,90.1 L50.0,91.4 L65.0,93.0 L80.0,93.9 L95.0,95.4 L110.0,96.2 L125.0,97.9 L140.0,99.3 L155.0,100.2 L170.0,101.3 L185.0,102.6 L200.0,104.2 L215.0,105.7 L230.0,106.2 L245.0,107.6 L260.0,109.0 L275.0,110.7 L290.0,111.5 L305.0,113.3 L320.0,114.1 L335.0,115.7 L350.0,116.9 L365.0,118.0 L380.0,119.3 L395.0,120.7 L410.0,121.8 L425.0,122.9 L440.0,124.7 L455.0,125.8 L470.0,127.0 L485.0,128.2 L500.0,129.5 L515.0,130.8 L530.0,132.2 L545.0,133.3 L560.0,134.7 L575.0,136.0 L590.0,137.3 L605.0,138.6 L620.0,139.8 L620.0,160.2 L605.0,162.6 L590.0,165.0 L575.0,167.0 L560.0,169.4 L545.0,171.6 L530.0,173.8 L515.0,176.4 L500.0,178.6 L485.0,181.1 L470.0,183.3 L455.0,185.7 L440.0,187.7 L425.0,190.4 L410.0,191.8 L395.0,194.5 L380.0,196.8 L365.0,198.9 L350.0,201.8 L335.0,203.9 L320.0,206.4 L305.0,208.8 L290.0,210.9 L275.0,212.6 L260.0,215.0 L245.0,217.9 L230.0,219.7 L215.0,222.4 L200.0,224.5 L185.0,226.7 L170.0,228.9 L155.0,231.7 L140.0,233.5 L125.0,235.8 L110.0,238.0 L95.0,240.8 L80.0,242.8 L65.0,245.4 L50.0,247.9 L35.0,249.0 L20.0,251.7 Z" />
