---
// The spread of a player's match day by experience, drawn from the match engine's own day
// model (MatchEngineMath.generateMatchAttributeOffset, average professionalism). Experience is
// the EXP the app shows (0-200); the day's shift has no numbers on purpose.
import { defaultLocale, type Locale } from '../../i18n/ui';

const labels = {
  en: {
    title: 'How much a player’s day can vary, by experience',
    exp: 'EXP',
    better: 'better day',
    worse: 'worse day',
    usual: 'usual level',
    full: 'possible range',
    most: '9 games in 10',
    half: 'half of the games',
  },
  cs: {
    title: 'Jak moc se může lišit den hráče podle zkušeností',
    exp: 'ZK',
    better: 'lepší den',
    worse: 'horší den',
    usual: 'obvyklá úroveň',
    full: 'možný rozsah',
    most: '9 zápasů z 10',
    half: 'polovina zápasů',
  },
};
// The page's language comes from the route, so MDX can use <ExperienceChart /> bare.
const l = labels[(Astro.params.lang as Locale) as keyof typeof labels] ?? labels[defaultLocale as 'en'];
---

<figure class="chart">
  <svg viewBox="0 0 640 345" role="img" aria-label={l.title}>
