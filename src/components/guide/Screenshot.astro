---
// A screenshot from the app with a caption. Images live in src/assets/screens/<lang>/<name>.webp;
// a language without its own set falls back to English. Taken from a dev world where every
// club is "IceFlow <nickname>" and every player "Name Surname", so nothing shows a real or
// generated name.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { defaultLocale, type Locale } from '../../i18n/ui';

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*/*.webp', { eager: true });
const lang = Astro.params.lang as Locale;
const src =
  images[`../../assets/screens/${lang}/${name}.webp`] ?? images[`../../assets/screens/${defaultLocale}/${name}.webp`];
if (!src) throw new Error(`Missing screenshot "${name}"`);
---

<figure class="shot">
  <a href={src.default.src} target="_blank" rel="noopener">
    <Image src={src.default} alt={alt} widths={[640, 960, 1440]} sizes="(max-width: 800px) 100vw, 760px" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 1.2em 0 1.6em;
  }

  .shot a {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
