---
// A screenshot from the app with a caption; clicking it opens the full-size image in a lightbox
// over the page. Images live in src/assets/screens/en/<name>.webp - every language shows the
// English app for now. Taken from a dev world where every club is "IceFlow <nickname>" and every
// player "Name Surname", so nothing shows a real or generated name.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Plain image without the figure margin and caption, for layouts that place it themselves. */
  bare?: boolean;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { name, alt, caption, bare = false, sizes = '(max-width: 800px) 100vw, 760px', loading = 'lazy' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/en/*.webp', { eager: true });
const src = images[`../../assets/screens/en/${name}.webp`];
if (!src) throw new Error(`Missing screenshot "${name}"`);
const full = await getImage({ src: src.default, width: Math.min(src.default.width, 2400) });
---

<figure class:list={['shot', { bare }]}>
  <a href={full.src} class="zoom" data-lightbox aria-label={alt}>
    <Image src={src.default} alt={alt} widths={[640, 960, 1440]} sizes={sizes} loading={loading} />
  </a>
  {caption && !bare && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // One shared <dialog> for every screenshot on the page. Opens on click, closes on a click
  // anywhere, Escape (native dialog behaviour) or the close button.
  function lightbox(): HTMLDialogElement {
    let dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.innerHTML =
      '<button type="button" class="lightbox-close" aria-label="Close">&times;</button><img alt="" /><p class="lightbox-caption"></p>';
    dialog.addEventListener('click', () => dialog!.close());
    dialog.addEventListener('close', () => document.documentElement.classList.remove('lightbox-open'));
    document.body.append(dialog);
    return dialog;
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const dialog = lightbox();
    const img = dialog.querySelector('img')!;
    img.src = link.href;
    img.alt = link.getAttribute('aria-label') ?? '';
    dialog.querySelector('.lightbox-caption')!.textContent =
      link.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
    document.documentElement.classList.add('lightbox-open');
    dialog.showModal();
  });
</script>

<style>
  .shot {
    margin: 1.2em 0 1.6em;
  }

  .shot.bare {
    margin: 0;
  }

  .zoom {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.25s ease;
  }

  .zoom:hover :global(img) {
    transform: scale(1.01);
  }

  figcaption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  :global(dialog.lightbox) {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 24px;
    border: 0;
    background: transparent;
    display: none;
    place-items: center;
    align-content: center;
    gap: 10px;
    cursor: zoom-out;
  }

  :global(dialog.lightbox[open]) {
    display: grid;
    animation: lightbox-in 0.18s ease-out;
  }

  :global(dialog.lightbox::backdrop) {
    background: rgb(4 8 14 / 0.88);
    backdrop-filter: blur(4px);
  }

  :global(dialog.lightbox img) {
    max-width: min(100%, 1600px);
    max-height: calc(100vh - 110px);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.6);
  }

  :global(.lightbox-caption) {
    margin: 0;
    max-width: 80ch;
    text-align: center;
    color: #c9d4e3;
    font-size: 0.9rem;
  }

  :global(.lightbox-close) {
    position: fixed;
    top: 12px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  :global(html.lightbox-open) {
    overflow: hidden;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
</style>
