---
// The 21 game days of a season with the dates the game's rules and competition calendar fix
// (iceflow-server season/simulation/CompetitionCalendar.kt): league group stage to day 19,
// league playoff on days 20-21, Elite group rounds and playoff, sponsor payments, the junior
// signing window and the day-15 selling deadline.
import { defaultLocale, type Locale } from '../../i18n/ui';

const labels = {
  en: {
    title: 'A season of 21 game days',
    league: 'League',
    group: 'Group stage - 44 games',
    playoff: 'Playoff',
    elite: 'Elite',
    eliteGroup: 'group round',
    eliteKo: 'playoff',
    juniors: 'Junior signing',
    juniorsSeen: 'Real ratings still visible',
    sponsors: 'Sponsor payments',
    selling: 'Day 15: last day to sell players in their contract’s final season or retiring',
  },
  cs: {
    title: 'Sezóna o 21 herních dnech',
    league: 'Liga',
    group: 'Základní část - 44 zápasů',
    playoff: 'Play-off',
    elite: 'Elite',
    eliteGroup: 'kolo skupiny',
    eliteKo: 'play-off',
    juniors: 'Podpis juniorů',
    juniorsSeen: 'Skutečné ratingy ještě vidět',
    sponsors: 'Platby sponzorů',
    selling: '15. den: poslední den prodeje hráčů v poslední sezóně smlouvy a před koncem kariéry',
  },
};
const lang = Astro.params.lang as Locale;
const l = labels[lang as keyof typeof labels] ?? labels[defaultLocale as 'en'];

const left = 70;
const width = 560;
const col = width / 21;
const x = (d: number) => left + col * (d - 1);
const cx = (d: number) => x(d) + col / 2;
const days = Array.from({ length: 21 }, (_, i) => i + 1);
const eliteGroup = [2, 4, 6, 9, 11, 13];
const eliteKo = [15, 16, 18, 19];
---

<figure class="chart">
  <svg viewBox="0 0 640 260" role="img" aria-label={l.title}>
    <title>{l.title}</title>
    {days.map((d) => (
      <text class="axis mid" x={cx(d)} y="16">{d}</text>
    ))}

    <text class="row" x="0" y="44">{l.league}</text>
    <rect class="group" x={x(1)} y="28" width={col * 19 - 2} height="26" rx="5" />
    <text class="label" x={x(1) + 8} y="46">{l.group}</text>
    <rect class="po" x={x(20)} y="28" width={col * 2 - 2} height="26" rx="5" />
    <text class="label dark mid" x={x(20) + col} y="46">{l.playoff}</text>

    <text class="row" x="0" y="84">{l.elite}</text>
    <line class="track" x1={x(1)} x2={x(22)} y1="80" y2="80" />
    {eliteGroup.map((d) => <circle class="eg" cx={cx(d)} cy="80" r="7" />)}
    {eliteKo.map((d) => <rect class="ek" x={cx(d) - 7} y="73" width="14" height="14" rx="3" />)}
    <circle class="eg" cx={x(1) + 6} cy="104" r="5" />
    <text class="note" x={x(1) + 16} y="108">{l.eliteGroup}</text>
    <rect class="ek" x={x(7)} y="99" width="10" height="10" rx="2" />
    <text class="note" x={x(7) + 16} y="108">{l.eliteKo}</text>

    <rect class="juniors" x={x(1)} y="126" width={col * 7 - 2} height="22" rx="5" />
    <rect class="juniors seen" x={x(8)} y="126" width={col * 7 - 2} height="22" rx="5" />
    <text class="label small" x={x(1) + 6} y="141">{l.juniors}</text>
    <text class="label small" x={x(8) + 6} y="141">{l.juniorsSeen}</text>

    {[1, 8, 15].map((d) => <circle class="sponsor" cx={cx(d)} cy="176" r="7" />)}
    <text class="note" x={cx(15) + 14} y="180">{l.sponsors}</text>

    <line class="deadline" x1={x(16)} x2={x(16)} y1="196" y2="224" />
    <text class="note" x="0" y="244">{l.selling}</text>
  </svg>
</figure>

<style>
  .chart {
    margin: 1.2em 0 1.6em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis {
    fill: var(--muted);
    font-size: 12px;
  }

  .row {
    fill: var(--text);
    font-size: 13px;
    font-weight: 700;
  }

  .mid {
    text-anchor: middle;
  }

  .end {
    text-anchor: end;
  }

  .group {
    fill: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .po {
    fill: var(--gold);
  }

  .track {
    stroke: var(--border);
    stroke-width: 2;
  }

  .eg {
    fill: #b48cff;
  }

  .ek {
    fill: #ff7a8a;
  }

  .juniors {
    fill: color-mix(in srgb, #3ccf91 45%, transparent);
  }

  .juniors.seen {
    fill: color-mix(in srgb, #3ccf91 15%, transparent);
  }

  .sponsor {
    fill: var(--accent);
  }

  .deadline {
    stroke: #ff7a8a;
    stroke-width: 3;
  }

  .label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 700;
  }

  .label.dark {
    fill: #081018;
  }

  .label.small {
    font-size: 11.5px;
  }

  .note {
    fill: var(--muted);
    font-size: 12px;
  }
</style>
