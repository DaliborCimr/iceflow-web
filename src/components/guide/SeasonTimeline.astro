---
// The 21 game days of a season with the dates the app's rules fix: sponsor payments
// (days 1, 8, 15), junior signing window (to day 7, ratings visible to day 14), the selling
// deadline for expiring and retiring players (day 15), the group stage and the playoff.
import { defaultLocale, type Locale } from '../../i18n/ui';

const labels = {
  en: {
    title: 'A season of 21 game days',
    day: 'day',
    group: 'Group stage - 44 league games',
    qf: 'Quarterfinal',
    final: 'Semifinal and final',
    sponsors: 'Sponsor payments',
    juniors: 'Junior signing',
    juniorsSeen: 'Real ratings still visible',
    selling: 'Last day to sell expiring and retiring players',
  },
  cs: {
    title: 'Sezóna o 21 herních dnech',
    day: 'den',
    group: 'Základní část - 44 ligových zápasů',
    qf: 'Čtvrtfinále',
    final: 'Semifinále a finále',
    sponsors: 'Platby sponzorů',
    juniors: 'Podpis juniorů',
    juniorsSeen: 'Skutečné ratingy ještě vidět',
    selling: 'Poslední den prodeje končících a odcházejících hráčů',
  },
};
const lang = Astro.params.lang as Locale;
const l = labels[lang as keyof typeof labels] ?? labels[defaultLocale as 'en'];

// One column per day; x of the start of day d (1-based).
const left = 20;
const width = 600;
const col = width / 21;
const x = (d: number) => left + col * (d - 1);
const days = Array.from({ length: 21 }, (_, i) => i + 1);
---

<figure class="chart">
  <svg viewBox="0 0 640 250" role="img" aria-label={l.title}>
    <title>{l.title}</title>
    {days.map((d) => (
      <text class="axis mid" x={x(d) + col / 2} y="20">{d}</text>
    ))}

    <rect class="group" x={x(1)} y="32" width={col * 19 - 2} height="30" rx="5" />
    <text class="label" x={x(1) + 10} y="52">{l.group}</text>
    <rect class="po" x={x(20)} y="32" width={col - 2} height="30" rx="5" />
    <rect class="po final" x={x(21)} y="32" width={col - 2} height="30" rx="5" />
    <text class="note end" x={x(22) - 2} y="80">{l.qf} · {l.final}</text>

    <rect class="juniors" x={x(1)} y="98" width={col * 7 - 2} height="22" rx="5" />
    <rect class="juniors seen" x={x(8)} y="98" width={col * 7 - 2} height="22" rx="5" />
    <text class="label small" x={x(1) + 8} y="113">{l.juniors}</text>
    <text class="label small" x={x(8) + 8} y="113">{l.juniorsSeen}</text>

    {[1, 8, 15].map((d) => (
      <circle class="sponsor" cx={x(d) + col / 2} cy="150" r="8" />
    ))}
    <text class="note" x={x(16) + 4} y="154">{l.sponsors}</text>

    <line class="deadline" x1={x(16)} x2={x(16)} y1="172" y2="200" />
    <text class="note end" x={x(16) - 8} y="194">{l.selling} →</text>
  </svg>
  <figcaption>{l.day} 1 – 21</figcaption>
</figure>

<style>
  .chart {
    margin: 1.2em 0 1.6em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 14px 8px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis {
    fill: var(--muted);
    font-size: 12px;
  }

  .mid {
    text-anchor: middle;
  }

  .end {
    text-anchor: end;
  }

  .group {
    fill: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .po {
    fill: var(--gold);
  }

  .po.final {
    fill: color-mix(in srgb, var(--gold) 70%, white);
  }

  .juniors {
    fill: color-mix(in srgb, #3ccf91 45%, transparent);
  }

  .juniors.seen {
    fill: color-mix(in srgb, #3ccf91 15%, transparent);
  }

  .sponsor {
    fill: var(--accent);
  }

  .deadline {
    stroke: #ff7a8a;
    stroke-width: 3;
  }

  .label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 700;
  }

  .label.small {
    font-size: 11.5px;
  }

  .note {
    fill: var(--muted);
    font-size: 12px;
  }

  figcaption {
    color: var(--muted);
    font-size: 0.8rem;
    text-align: right;
  }
</style>
