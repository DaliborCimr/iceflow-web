---
import { url } from '../url';
// Documentation layout: guide contents on the left (a drawer on phones), the article in the
// middle, "on this page" on the right, previous/next at the bottom.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import GuideNav from '../components/guide/GuideNav.astro';
import Search from '../components/guide/Search.astro';
import type { GuideItem } from '../i18n/guide';
import { useTranslations, type Locale, type UiKey } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  items: GuideItem[];
  current?: GuideItem;
  headings?: Heading[];
}

const { lang, title, description, items, current, headings = [] } = Astro.props;
const t = useTranslations(lang);
const index = current ? items.findIndex((i) => i.slug === current.slug) : -1;
const prev = index > 0 ? items[index - 1] : undefined;
const next = index >= 0 && index < items.length - 1 ? items[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base lang={lang} title={title} description={description}>
  <div class="container docs">
    <aside class="sidebar">
      <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="guide-drawer">
        <Icon name="menu_book" size={18} />
        {t('guide.contents')}
        <Icon name="keyboard_arrow_down" size={20} class="chevron" />
      </button>
      <div class="drawer-body" id="guide-drawer">
        <Search lang={lang} />
        <GuideNav lang={lang} items={items} current={current?.slug} />
      </div>
    </aside>

    <article class="content prose-doc" data-pagefind-body>
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href={url(`/${lang}/guide/`)}>{t('nav.guide')}</a>
        {current && (
          <>
            <span aria-hidden="true">›</span>
            <span>{t(`guide.group.${current.entry.data.group}` as UiKey)}</span>
          </>
        )}
      </nav>
      <slot />

      <p class="basis" data-pagefind-ignore>{t('guide.basis')}</p>

      {(prev || next) && (
        <nav class="pager" data-pagefind-ignore>
          {prev ? (
            <a class="prev" href={url(`/${lang}/guide/${prev.slug}/`)}>
              <small>{t('guide.prev')}</small>
              <span>{prev.entry.data.title}</span>
            </a>
          ) : <span />}
          {next && (
            <a class="next" href={url(`/${lang}/guide/${next.slug}/`)}>
              <small>{t('guide.next')}</small>
              <span>{next.entry.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>

    {toc.length > 1 && (
      <aside class="toc" data-pagefind-ignore>
        <p class="toc-title">{t('guide.onThisPage')}</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>

<script is:inline>
  // Phones: the contents drawer opens and closes with its button. Wide screens always show it.
  document.querySelectorAll('.drawer-toggle').forEach((button) =>
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.closest('.sidebar')?.classList.toggle('open', open);
    }),
  );
  // Highlight the section being read in "On this page".
  const links = [...document.querySelectorAll('.toc a')];
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('active'));
          byId.get(e.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>

<style>
  .docs {
    max-width: 1280px;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 200px;
    gap: 40px;
    align-items: start;
    padding-block: 28px 64px;
  }

  .sidebar,
  .toc {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .drawer-toggle {
    display: none;
  }

  .content {
    min-width: 0;
    max-width: 760px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .crumbs a {
    color: var(--muted);
  }

  .basis {
    margin-top: 40px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .pager small {
    color: var(--muted);
    font-weight: 400;
  }

  .next {
    text-align: right;
    grid-column: 2;
  }

  .toc-title {
    margin: 0 0 8px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc a {
    display: block;
    padding: 4px 0 4px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .toc .d3 a {
    padding-left: 24px;
  }

  .toc a:hover,
  .toc a.active {
    color: var(--text);
    border-left-color: var(--accent);
  }

  @media (max-width: 1199px) {
    .docs {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .docs {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-top: 16px;
    }

    .sidebar {
      position: static;
      max-height: none;
    }

    .drawer-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      cursor: pointer;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-weight: 700;
    }

    .drawer-toggle :global(.chevron) {
      margin-left: auto;
      transition: transform 0.15s;
    }

    .open .drawer-toggle :global(.chevron) {
      transform: rotate(180deg);
    }

    .drawer-body {
      display: none;
      padding: 12px 4px 4px;
    }

    .open .drawer-body {
      display: block;
    }
  }
</style>
