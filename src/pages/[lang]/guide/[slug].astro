---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getLocalizedCollection } from '../../../i18n/content';
import { locales, useTranslations, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) =>
      (await getLocalizedCollection('guide', lang)).map((item) => ({
        params: { lang, slug: item.slug },
        props: item,
      })),
    ),
  );
  return paths.flat();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { entry, isFallback } = Astro.props;
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article class="container prose">
    <p class="meta"><a href={`/${lang}/guide/`}>← {t('guide.title')}</a></p>
    {isFallback && <p class="notice">{t('legal.fallbackNotice')}</p>}
    <div lang={isFallback ? 'en' : undefined}>
      <h1>{entry.data.title}</h1>
      <Content />
    </div>
  </article>
</Base>
