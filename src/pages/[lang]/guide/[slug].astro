---
import { render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import Rule from '../../../components/guide/Rule.astro';
import Rules from '../../../components/guide/Rules.astro';
import Callout from '../../../components/guide/Callout.astro';
import ExperienceChart from '../../../components/guide/ExperienceChart.astro';
import StrengthChart from '../../../components/guide/StrengthChart.astro';
import SeasonTimeline from '../../../components/guide/SeasonTimeline.astro';
import TacticFitTable from '../../../components/guide/TacticFitTable.astro';
import Sources from '../../../components/guide/Sources.astro';
import Screenshot from '../../../components/guide/Screenshot.astro';
import Clip from '../../../components/guide/Clip.astro';
import ShotPair from '../../../components/guide/ShotPair.astro';
import { getGuide } from '../../../i18n/guide';
import { locales, useTranslations, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) =>
      (await getGuide(lang)).map((item) => ({ params: { lang, slug: item.slug }, props: { item } })),
    ),
  );
  return paths.flat();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { item } = Astro.props;
const items = await getGuide(lang);
const { Content, headings } = await render(item.entry);
const components = { Rule, Rules, Callout, ExperienceChart, StrengthChart, SeasonTimeline, TacticFitTable, Sources, Screenshot, Clip, ShotPair };
---

<GuideLayout
  lang={lang}
  title={item.entry.data.title}
  description={item.entry.data.description}
  items={items}
  current={item}
  headings={headings}
>
  {item.isFallback && <p class="notice">{t('legal.fallbackNotice')}</p>}
  <div lang={item.isFallback ? 'en' : undefined} class="doc">
    <h1>{item.entry.data.title}</h1>
    <p class="lead">{item.entry.data.description}</p>
    <Content components={components} />
  </div>
</GuideLayout>
