---
import Base from '../../../layouts/Base.astro';
import { getLocalizedCollection } from '../../../i18n/content';
import { localePaths, useTranslations, type Locale } from '../../../i18n/ui';

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const articles = (await getLocalizedCollection('guide', lang)).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);
---

<Base lang={lang} title={t('guide.title')} description={t('guide.intro')}>
  <section class="container prose">
    <h1>{t('guide.title')}</h1>
    <p class="meta">{t('guide.intro')}</p>
    {articles.length === 0 ? (
      <p>{t('guide.empty')}</p>
    ) : (
      <ul class="list">
        {articles.map(({ entry, slug, isFallback }) => (
          <li lang={isFallback ? 'en' : undefined}>
            <a href={`/${lang}/guide/${slug}/`}>{entry.data.title}</a>
            <p>{entry.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .list li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 18px;
  }

  .list a {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .list p {
    margin: 4px 0 0;
    color: var(--muted);
  }
</style>
