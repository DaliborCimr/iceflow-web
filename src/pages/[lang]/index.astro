---
import { url } from '../../url';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import homeShot from '../../assets/screens/en/home.webp';
import trailerPoster from '../../assets/screens/en/trailer.webp';
import { getImage } from 'astro:assets';
import { localePaths, useTranslations, type Locale, type UiKey } from '../../i18n/ui';
import { fullName } from '../../brand';

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const features = [
  { key: 'match', icon: 'sports_hockey' },
  { key: 'team', icon: 'tune' },
  { key: 'juniors', icon: 'person_search' },
  { key: 'transfers', icon: 'swap_horiz' },
  { key: 'club', icon: 'stadium' },
  { key: 'leagues', icon: 'trophy' },
] as const;

// Every number is a current game setting (SeasonRules, the tactic catalogue, the lineup shape).
const stats = [
  { value: '21', label: 'home.stat.days' },
  { value: '3', label: 'home.stat.blocks' },
  { value: '6 + 6', label: 'home.stat.tactics' },
  { value: '4', label: 'home.stat.lines' },
] as const;

const poster = await getImage({ src: trailerPoster, width: 1600 });

const chips = [
  { icon: 'mobile', label: 'home.chipMobile' },
  { icon: 'public', label: 'home.chipOnline' },
  { icon: 'translate', label: 'home.chipLanguages' },
] as const;
---

<Base lang={lang} title={fullName} description={t('home.tagline')}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{t('home.title')}</p>
        <h1>{fullName}</h1>
        <p class="tagline">{t('home.tagline')}</p>
        <div class="actions">
          <a class="btn primary" href={url(`/${lang}/guide/`)}>
            {t('home.ctaGuide')}
            <Icon name="arrow_forward" size={18} />
          </a>
          <a class="btn ghost" href={url(`/${lang}/story/`)}>{t('home.ctaStory')}</a>
        </div>
        <ul class="chips">
          {chips.map((c) => (
            <li>
              <Icon name={c.icon} size={16} />
              {t(c.label as UiKey)}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="glow"></div>
        <div class="device">
          <Image src={homeShot} alt="" widths={[640, 960, 1440]} sizes="(max-width: 900px) 92vw, 620px" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="container trailer" aria-label={t('home.trailer')}>
    <video
      src={url('/media/trailer.mp4')}
      poster={poster.src}
      aria-label={t('home.trailer')}
      controls
      muted
      loop
      playsinline
      preload="none"
      data-trailer
    ></video>
  </section>

  <section class="container features">
    <h2>{t('home.featuresTitle')}</h2>
    <ul class="bento">
      {features.map((f, i) => (
        <li class:list={['card', { wide: i === 0 || i === features.length - 1 }]}>
          <span class="icon"><Icon name={f.icon} size={24} /></span>
          <h3>{t(`feature.${f.key}.title` as UiKey)}</h3>
          <p>{t(`feature.${f.key}.text` as UiKey)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="band">
    <div class="container">
      <h2>{t('home.statsTitle')}</h2>
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{t(s.label as UiKey)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="container more">
    <h2>{t('home.moreTitle')}</h2>
    <div class="links">
      <a href={url(`/${lang}/guide/`)}>
        <span class="icon"><Icon name="menu_book" size={24} /></span>
        <span>
          <strong>{t('nav.guide')}</strong>
          <span>{t('home.guideText')}</span>
        </span>
        <Icon name="arrow_forward" size={20} class="arrow" />
      </a>
      <a href={url(`/${lang}/story/`)}>
        <span class="icon"><Icon name="auto_stories" size={24} /></span>
        <span>
          <strong>{t('nav.story')}</strong>
          <span>{t('home.storyText')}</span>
        </span>
        <Icon name="arrow_forward" size={20} class="arrow" />
      </a>
    </div>
  </section>
</Base>

<script>
  // The trailer plays by itself while half of it is on screen (never with reduced motion).
  const trailer = document.querySelector<HTMLVideoElement>('video[data-trailer]');
  if (trailer && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? trailer.play().catch(() => {}) : trailer.pause()),
      { threshold: 0.5 },
    ).observe(trailer);
  }
</script>

<style>
  h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60% 80% at 85% 20%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, color-mix(in srgb, var(--gold) 8%, transparent), transparent 70%),
      linear-gradient(180deg, #0a1722 0%, var(--bg) 100%);
  }

  .hero::before {
    /* faint rink lines */
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, transparent calc(50% - 1px), rgb(255 255 255 / 0.04) 50%, transparent calc(50% + 1px));
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 48px;
    align-items: center;
    padding-block: clamp(40px, 8vw, 96px);
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 16px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    background: color-mix(in srgb, var(--gold) 10%, transparent);
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    /* background-clip: text paints only the box: room for the descenders (g, y). */
    padding-bottom: 0.12em;
    margin: 0 0 6px;
    background: linear-gradient(180deg, #ffffff 30%, #b9d6ea);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    color: var(--muted);
    font-size: 1.12rem;
    margin: 0 0 28px;
    max-width: 48ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--accent);
    color: #031018;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .btn.primary:hover {
    background: #3cc2f5;
    color: #031018;
  }

  .btn.ghost {
    border: 1px solid var(--border);
    color: var(--text);
    background: rgb(255 255 255 / 0.03);
  }

  .btn.ghost:hover {
    border-color: var(--accent);
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .chips :global(svg) {
    color: var(--accent);
  }

  .hero-visual {
    position: relative;
    perspective: 1400px;
  }

  .glow {
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 45%, transparent), transparent);
    filter: blur(40px);
  }

  .device {
    position: relative;
    padding: 10px 10px 10px 22px;
    border-radius: 28px;
    background: linear-gradient(145deg, #2a3946, #0b141c 40%, #1a2631);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      0 30px 80px rgb(0 0 0 / 0.55);
    transform: rotateY(-10deg) rotateX(4deg);
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
  }

  .device::before {
    /* front camera */
    content: '';
    position: absolute;
    left: 8px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: #05090d;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .hero-visual:hover .device {
    transform: rotateY(-4deg) rotateX(2deg);
  }

  .device :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
  }

  /* Trailer */
  .trailer {
    margin-top: clamp(-56px, -4vw, -24px);
    position: relative;
  }

  .trailer video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }

  /* Features */
  .features {
    padding-block: clamp(48px, 7vw, 80px) 24px;
  }

  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    position: relative;
    padding: 22px 22px 20px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, color-mix(in srgb, var(--surface) 92%, #ffffff 8%), var(--surface));
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    transform: translateY(-2px);
  }

  .card.wide {
    grid-column: span 2;
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--surface) 92%, #ffffff 8%), var(--surface));
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }

  .card h3 {
    margin: 14px 0 6px;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  /* Stats band */
  .band {
    margin-top: clamp(40px, 6vw, 64px);
    padding-block: clamp(40px, 6vw, 64px);
    border-block: 1px solid var(--border);
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%), var(--surface-2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
  }

  .stats dt {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .stats dd {
    margin: 8px 0 0;
    color: var(--muted);
    max-width: 22ch;
  }

  /* More */
  .more {
    padding-block: clamp(48px, 7vw, 80px);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .links a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 20px 22px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .links a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .links strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 2px;
  }

  .links span span {
    color: var(--muted);
  }

  .links :global(.arrow) {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .links a:hover :global(.arrow) {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .device {
      transform: none;
    }

    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .bento,
    .links {
      grid-template-columns: 1fr;
    }

    .card.wide {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .device,
    .card,
    .btn,
    .links a {
      transition: none;
    }
  }
</style>
