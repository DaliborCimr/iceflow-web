---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLocalizedEntry } from '../../i18n/content';
import { localePaths, useTranslations, type Locale } from '../../i18n/ui';

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { entry, isFallback } = await getLocalizedEntry('story', 'story', lang);
const { Content } = await render(entry);
const d = entry.data;
const textLang = isFallback ? 'en' : undefined;
---

<Base lang={lang} title={d.title} description={d.description}>
  <div lang={textLang}>
    <section class="hero">
      <div class="container inner">
        {isFallback && <p class="notice" lang={lang}>{t('legal.fallbackNotice')}</p>}
        <h1>{d.title}</h1>
        <p class="lead">{d.lead}</p>
        <ul class="stats">
          {d.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="container inner">
      <h2>{d.timelineTitle}</h2>
      <ol class="timeline">
        {d.milestones.map((m) => (
          <li class={`phase-${m.phase}`}>
            <div class="marker" aria-hidden="true"></div>
            <div class="when">
              <time>{m.date}</time>
              <span class="tag">{m.phaseLabel}</span>
            </div>
            <div class="card">
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="container inner closing">
      <h2>{d.closingTitle}</h2>
      <Content />
    </section>
  </div>
</Base>

<style>
  .inner {
    max-width: 820px;
  }

  .hero {
    background: radial-gradient(ellipse at 20% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 65%);
    border-bottom: 1px solid var(--border);
    padding-block: 40px 32px;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 14px;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 28px;
  }

  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .stats li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
  }

  .stats strong {
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stats span {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.35;
    margin-top: 4px;
  }

  h2 {
    margin: 40px 0 20px;
    font-size: 1.4rem;
  }

  /* Vertical timeline: a rail on the left, date column, then the card. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--border);
  }

  .timeline li {
    --phase: var(--accent);
    position: relative;
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 6px 20px;
    padding-left: 32px;
    margin-bottom: 16px;
  }

  .timeline li.phase-idea { --phase: #b48cff; }
  .timeline li.phase-engine { --phase: var(--gold); }
  .timeline li.phase-server { --phase: var(--accent); }
  .timeline li.phase-mobile { --phase: #3ccf91; }
  .timeline li.phase-animation { --phase: #ff7a8a; }
  .timeline li.phase-launch { --phase: #ffffff; }

  .marker {
    position: absolute;
    left: 0;
    top: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--phase);
  }

  .when {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 4px;
  }

  time {
    font-weight: 700;
  }

  .tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--phase);
    border: 1px solid color-mix(in srgb, var(--phase) 50%, transparent);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--phase);
    border-radius: var(--radius);
    padding: 12px 16px;
  }

  .card h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .closing {
    padding-bottom: 64px;
  }

  .closing :global(p) {
    font-size: 1.05rem;
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .timeline li {
      grid-template-columns: 1fr;
    }

    .when {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      padding-top: 2px;
    }
  }
</style>
