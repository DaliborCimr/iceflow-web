{
  "output": "out/trailer.mp4",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "transition": 0.5,
  "fonts": [
    "fonts/OpenSans-SemiBold.ttf",
    "C:/Windows/Fonts/seguisb.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
  ],
  "segments": [
    { "type": "title", "text": "BUILD YOUR SQUAD", "duration": 2.2, "reveal": 1.0 },
    { "type": "clip", "path": "assets/team-controls.mp4", "taps": "assets/team-controls.taps.json", "start": 2.4, "end": 4.6 },

    { "type": "title", "text": "LEAD YOUR TEAM", "duration": 2.2, "reveal": 1.0 },
    { "type": "clip", "path": "assets/player-swap.mp4", "taps": "assets/player-swap.taps.json", "start": 0.6, "end": 4.6, "speed": 1.6 },
    { "type": "clip", "path": "assets/goal-highlight.mp4", "start": 5.9, "end": 8.05 },

    { "type": "title", "text": "DRAFT TALENTS", "duration": 2.2, "reveal": 1.0 },
    { "type": "clip", "path": "assets/junior-draft.mp4", "taps": "assets/junior-draft.taps.json", "start": 0.7, "speed": 1.5, "hold": 0.8 },

    { "type": "title", "text": "EVERY DECISION MATTERS", "duration": 2.4, "reveal": 1.1 },
    { "type": "clip", "path": "assets/subtle_contract_pen_animation.mp4", "speed": 2, "end": 3.6 },
    {
      "type": "logo_zoom",
      "transition": 0,
      "path": "assets/subtle_contract_pen_animation.mp4",
      "from": 3.6,
      "speed": 2,
      "box": [967, 55, 1230, 262],
      "logo": "../src/assets/branding/logo_name.png",
      "duration": 3.2,
      "zoom": 2.4,
      "margin": 1.5
    }
  ]
}
